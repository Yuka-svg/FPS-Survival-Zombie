@import url("../USS/Theme.uss");
@import url("../USS/Shared.uss");

/* ============================================================
   ChapterSummary.uss — Chapter recap panel (B4, story mode)
   PanelManager toggles the "visible" class on panel + card.
   ============================================================ */

.chapter-summary-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: var(--transition-normal, 0.3s);
    transition-timing-function: ease-in-out;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(6, 8, 12, 0.82);
}

.chapter-summary-panel.visible {
    opacity: 1;
}

.chapter-summary-card {
    width: 640px;
    flex-direction: column;
    align-items: center;
    padding: 0;
    opacity: 0;
    scale: 0.94;
    transition-property: opacity, scale;
    transition-duration: var(--transition-normal, 0.3s), var(--transition-normal, 0.3s);
    transition-timing-function: ease-out, ease-out;
    background-color: var(--color-surface-bottom, rgba(16, 20, 28, 0.97));
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(217, 199, 115, 0.55);
    border-right-color: rgba(217, 199, 115, 0.55);
    border-top-color: rgba(217, 199, 115, 0.55);
    border-bottom-color: rgba(217, 199, 115, 0.55);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.75);
}

.chapter-summary-panel.visible .chapter-summary-card {
    opacity: 1;
    scale: 1;
}

.chapter-summary-title {
    -unity-font-definition: var(--font-display-sdf);
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-accent-gold, rgb(217, 199, 115));
    -unity-text-align: middle-center;
    padding-top: 34px;
    padding-bottom: 8px;
    letter-spacing: 4px;
    text-shadow: 0 0 14px rgba(217, 199, 115, 0.35), 1px 1px 3px rgba(0, 0, 0, 0.9);
}

.chapter-summary-subtitle {
    -unity-font-definition: var(--font-body-sdf);
    font-size: 15px;
    color: var(--color-text-secondary, rgb(210, 215, 225));
    -unity-text-align: middle-center;
    padding-left: 48px;
    padding-right: 48px;
    padding-bottom: 18px;
    white-space: normal;
    line-height: 1.5;
}

.chapter-summary-divider {
    width: 420px;
    height: 2px;
    background-color: rgba(217, 199, 115, 0.35);
    margin-bottom: 20px;
}

.chapter-summary-stats {
    flex-direction: column;
    width: 480px;
    padding-left: 32px;
    padding-right: 32px;
}

.chapter-summary-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-bottom: 6px;
}

.chapter-summary-icon {
    width: 14px;
    height: 14px;
    margin-right: 12px;
    border-radius: 2px;
    background-color: var(--color-accent-gold-dark, rgb(176, 156, 70));
    flex-shrink: 0;
}

.chapter-summary-label {
    flex-grow: 1;
    -unity-font-definition: var(--font-body-sdf);
    font-size: 15px;
    letter-spacing: 1.5px;
    color: var(--color-text-secondary, rgb(210, 215, 225));
    -unity-text-align: middle-left;
}

.chapter-summary-value {
    -unity-font-definition: var(--font-body-sdf);
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-primary, rgba(245, 245, 245, 1));
    -unity-text-align: middle-right;
}

.chapter-summary-hint {
    -unity-font-definition: var(--font-body-sdf);
    font-size: 12px;
    color: var(--color-text-muted, rgb(158, 168, 184));
    -unity-text-align: middle-center;
    padding-top: 14px;
    letter-spacing: 1px;
}

.chapter-summary-continue {
    width: 280px;
    height: 54px;
    flex-shrink: 0;
    margin: 14px auto 26px auto;
    font-size: var(--fs-l, 22px);
    -unity-font-definition: var(--font-body, resource("Fonts/Outfit-SemiBold SDF"));
    -unity-font-style: bold;
    color: var(--color-text-primary, rgba(245, 245, 245, 1));
    -unity-text-align: middle-center;
    background-color: var(--color-accent-gold-dark, rgb(176, 156, 70));
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 6px;
    border-bottom-right-radius: 6px;
    letter-spacing: 2px;
}

.chapter-summary-continue:hover {
    scale: 1.04;
    background-color: var(--color-accent-gold, rgb(217, 199, 115));
}

.chapter-summary-continue:active {
    scale: 0.96;
}
