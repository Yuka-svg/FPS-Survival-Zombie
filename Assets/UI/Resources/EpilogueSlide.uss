@import url("../USS/Theme.uss");
@import url("../USS/Shared.uss");

/* EpilogueSlide.uss — shared look for EpilogueSlide and FollowerEndingSlide.
   Opacity/translate/width animations are driven from code (unscaled time).
   The background gradient + vignette are generated as textures in code
   (USS gradients were rejected by the style engine in this Unity version),
   this sheet only provides layout + typography. */

#EpilogueRoot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 1;
}

#Background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 18, 32);
}

/* Texture (radial) assigned from code in EpilogueSlide.Build(). */
#Vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

#Content {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
    width: 80%;
}

.epilogue-title {
    font-size: 68px;
    -unity-font-style: bold;
    color: var(--color-text-gold, #d4af37);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    letter-spacing: 16px;
}

.epilogue-divider {
    width: 420px;
    height: 3px;
    background-color: var(--color-text-gold, #d4af37);
    margin-bottom: 44px;
    opacity: 0.7;
}

#Illustration {
    width: 720px;
    height: 420px;
    margin-bottom: 30px;
}

.epilogue-body {
    font-size: var(--fs-xxl, 34px);
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(205, 214, 224);
    min-height: 180px;
    width: 100%;
}
