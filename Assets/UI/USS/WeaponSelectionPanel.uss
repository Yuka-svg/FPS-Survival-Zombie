@import url("Shared.uss");

#GameUIRoot #WeaponSelectionPanel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-in-out;
}

#GameUIRoot #WeaponSelectionPanel.visible {
    opacity: 1;
}

#WeaponSelectionPanel #WeaponSelVignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("Images/ui_vignette");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-in-out;
}

#WeaponSelectionPanel.visible #WeaponSelVignette {
    opacity: 1;
}

#WeaponSelectionPanel #WeaponSelCard {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--panel-card-width, 760px);
    height: auto;
    max-height: 95%;
    max-width: 95%;
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-top: 40px;
    padding-bottom: 40px;
    opacity: 0;
    scale: 0;
    translate: -50% -50%;
    transition-property: opacity, scale, translate;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-in, ease-in, ease-in-out;
}

#WeaponSelectionPanel.visible #WeaponSelCard {
    opacity: 1;
    scale: 1;
    translate: -50% -50%;
    transition-property: opacity, scale, translate;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-out-back, ease-out-back, ease-in-out;
}

#WeaponSelectionPanel #WeaponSelTopAccent {
    width: 100%;
    height: 4px;
    flex-shrink: 0;
    background-color: var(--color-accent-red, rgb(230, 75, 75));
}

#WeaponSelectionPanel #WeaponSelTitle {
    font-size: var(--fs-display, 48px);
    -unity-font-definition: resource("Fonts/BlackOpsOne-Regular SDF");
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    width: 720px;
    height: 130px;
    margin-top: var(--space-l, 16px);
    flex-shrink: 0;
    color: var(--color-accent-red, rgb(230, 75, 75));
    -unity-text-outline-color: var(--color-text-shadow, rgba(0, 0, 0, 0.8));
    -unity-text-outline-width: var(--shadow-text-md, 2px);
}

#WeaponSelectionPanel #WeaponSelDivider {
    width: 620px;
    height: 2px;
    flex-shrink: 0;
    background-color: rgba(230, 75, 75, 0.2);
}

#WeaponSelectionPanel .weapon-sel-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 680px;
    height: auto;
    margin-top: var(--space-xl, 20px);
    flex-shrink: 0;
}

/* Weapon card (generated by code) */
#WeaponSelectionPanel .weapon-card {
    width: 150px;
    height: 180px;
    margin: 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 22, 30, 0.7);
    border-width: 1px;
    border-color: rgba(229, 72, 60, 0.3);
    border-radius: 4px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    cursor: pointer;
}

#WeaponSelectionPanel .weapon-card:hover {
    scale: 1.08;
    background-color: rgba(229, 72, 60, 0.15);
    border-color: rgb(229, 72, 60);
}

#WeaponSelectionPanel .weapon-card:active {
    scale: 0.95;
}

#WeaponSelectionPanel .weapon-card-icon {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 8px;
}

#WeaponSelectionPanel .weapon-card-name {
    font-size: 16px;
    -unity-font-definition: resource("Fonts/Outfit-SemiBold SDF");
    color: var(--color-text-primary, rgb(245, 245, 245));
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
    width: 130px;
    height: auto;
    white-space: normal;
}

#WeaponSelectionPanel .weapon-sel-hint {
    font-size: 14px;
    -unity-font-definition: resource("Fonts/Outfit-SemiBold SDF");
    color: rgba(245, 245, 245, 0.5);
    -unity-text-align: middle-center;
    margin-top: var(--space-m, 12px);
    letter-spacing: 2px;
}
