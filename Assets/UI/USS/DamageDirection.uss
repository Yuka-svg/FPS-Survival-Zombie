/* ===== DamageDirection.uss — Directional Damage Indicator ===== */
@import url("Shared.uss");

#DamageDirection {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.dir-pivot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    translate: -50% -50%;
    opacity: 0;
}

.dir-arc {
    position: absolute;
    left: 0;
    top: 0;
    background-image: url("project://database/Assets/UI/Resources/Icons/damage_indicator_wedge.svg");
    -unity-background-image-tint-color: var(--color-accent-red, rgb(229, 72, 60));
    -unity-background-scale-mode: stretch-to-fill;
}
