@import url("Shared.uss");

#QuestTracker {
    position: absolute;
    right: 20px;
    left: auto;
    top: 20px;
    width: 320px;
    flex-direction: column;
    padding: 12px 14px;
    background-color: transparent;
    border-width: 0;

    transition: opacity 0.25s ease-out, translate 0.25s ease-out;
}

#QuestTracker.quest-updating {
    opacity: 0.1;
    translate: 30px 0;
}

#MainPanel {
    flex-direction: column;
    padding: 0;
    margin: 0;
}

#Chapter {
    color: var(--color-accent-gold, rgb(217, 199, 115)); /* Gold accent for chapter heading */
    font-size: 11px;
    -unity-font-definition: var(--font-display-sdf);
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    letter-spacing: 1px;
}

#Title {
    color: var(--color-text-primary, rgb(245, 245, 245));
    font-size: 17px;
    -unity-font-definition: var(--font-body-sdf);
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

#Objective {
    color: var(--color-text-muted, rgb(158, 168, 184));
    font-size: 12px;
    -unity-font-definition: var(--font-body-sdf);
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

#Instructions {
    color: var(--color-text-muted, rgb(158, 168, 184));
    font-size: 11px;
    -unity-font-definition: var(--font-body-sdf);
    margin-top: 4px;
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

#Collectibles {
    color: var(--color-accent-cyan, rgb(78, 205, 196)); /* Cyan accent matching HUD chips */
    font-size: 11px;
    -unity-font-definition: var(--font-body-sdf);
    margin-top: 4px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.quest-divider {
    height: 1px;
    background-color: rgba(217, 199, 115, 0.15);
    margin-top: 8px;
    margin-bottom: 8px;
}

#SidePanel {
    padding: 0;
    margin: 0;
    flex-direction: column;
}

#SideHeader {
    color: var(--color-accent-cyan, rgb(78, 205, 196)); /* Cyan accent for side quests header */
    font-size: 11px;
    -unity-font-style: bold;
    -unity-font-definition: var(--font-body-sdf);
    margin-bottom: 4px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    letter-spacing: 1px;
}

#SideLines {
    flex-direction: column;
    color: var(--color-text-secondary, rgb(210, 215, 225));
}

.side-line,
.side-quest-line {
    color: var(--color-text-secondary, rgb(210, 215, 225));
    font-size: 12px;
    -unity-font-definition: var(--font-body-sdf);
    min-height: 18px;
    height: auto;
    white-space: normal;
    margin-bottom: 2px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

#MinimapContainer {
    width: 292px;
    height: 292px;
    position: relative;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
}

#MinimapImage {
    width: 292px;
    height: 292px;
    background-color: rgb(12, 16, 24);
}

#MinimapPlayerArrow {
    position: absolute;
    left: 136px;
    top: 136px;
    width: 20px;
    height: 20px;
    transform-origin: 50% 50%;
}

#MinimapMarkerLayer {
    position: absolute;
    left: 0;
    top: 0;
    width: 292px;
    height: 292px;
    overflow: hidden;
}

.minimap-blip-zombie {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #FF1111;
    border-width: 1px;
    border-color: #000000;
}

.minimap-blip-companion {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #00FFCC;
    border-width: 1.5px;
    border-color: #FFFFFF;
}

.minimap-blip-special {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #FF00FF;
    border-width: 1.5px;
    border-color: #FFFFFF;
}

.minimap-blip-boss {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #FF2200;
    border-width: 2px;
    border-color: #FFDD00;
    transform-origin: 50% 50%;
}

.minimap-blip-journal {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background-color: #FFDD00;
    border-width: 1px;
    border-color: #FFFFFF;
    transform-origin: 50% 50%;
}

.minimap-blip-sidequest {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #00FF66;
    border-width: 1px;
    border-color: #FFFFFF;
    transform-origin: 50% 50%;
}

#MinimapQuestMarker {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #00E5FF;
    border-width: 1.5px;
    border-color: #FFFFFF;
    transform-origin: 50% 50%;
}

#MinimapEdgeArrow {
    position: absolute;
    width: 16px;
    height: 16px;
    transform-origin: 50% 50%;
}

