/* ===== AdRewardPanel.uss — Sci-Fi Gold Tactical Ad Theme ===== */
@import url("Shared.uss");

#GameUIRoot #AdRewardPanel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-in-out;
}

#GameUIRoot #AdRewardPanel.visible {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

#AdRewardPanel #AdVignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("Images/ui_vignette");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-in-out;
}

#AdRewardPanel.visible #AdVignette {
    opacity: 1;
}

#AdRewardPanel #AdCard {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    height: 520px;
    max-height: 95%;
    max-width: 95%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 32px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 0;
    scale: 0;
    translate: -50% -50%;
    transition-property: opacity, scale, translate;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-in, ease-in, ease-in-out;
}

#AdRewardPanel.visible #AdCard {
    opacity: 1;
    scale: 1;
    translate: -50% -50%;
    transition-property: opacity, scale, translate;
    transition-duration: var(--premium-panel-transition-duration, 1.5s);
    transition-timing-function: ease-out-back, ease-out-back, ease-in-out;
}

#AdRewardPanel #AdCardShadow {
    display: none;
}

#AdRewardPanel #AdTopAccent {
    display: none;
}

#AdRewardPanel #AdIcon {
    width: 58px;
    height: 58px;
    margin-top: 0;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Resources/Icons/icon_star.svg");
    -unity-background-image-tint-color: var(--color-accent-gold, rgb(217, 199, 115));
    -unity-background-scale-mode: scale-to-fit;
}

#AdRewardPanel #AdTitle {
    font-size: var(--fs-display, 48px);
    -unity-font-definition: resource("Fonts/BlackOpsOne-Regular SDF");
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    width: 100%;
    height: auto;
    margin-top: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
    color: var(--color-accent-gold, rgb(217, 199, 115));
    -unity-text-outline-color: var(--color-text-shadow, rgba(0, 0, 0, 0.8));
    -unity-text-outline-width: var(--shadow-text-md, 2px);
}

#AdRewardPanel #AdDivider {
    width: 620px;
    height: 2px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 8px;
    background-color: rgba(217, 199, 115, 0.2);
}

#AdRewardPanel #AdContent {
    width: 620px;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: var(--space-m) 0;
    background-color: transparent;
    border-radius: var(--radius-s);
}

#AdRewardPanel .ad-placeholder {
    width: 100%;
    height: 100px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#AdRewardPanel .ad-placeholder-icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Resources/Icons/icon_star.svg");
    -unity-background-image-tint-color: var(--color-accent-gold, rgb(217, 199, 115));
    margin-bottom: var(--space-s);
}

#AdRewardPanel .ad-placeholder-label {
    font-size: var(--fs-l, 22px);
    -unity-font-definition: resource("Fonts/Outfit-SemiBold SDF");
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

#AdRewardPanel #AdPlayingOverlay {
    display: flex;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 14, 20, 0.85);
    border-radius: var(--radius-s);
    border-width: 1px;
    border-color: rgba(217, 199, 115, 0.2);
}

#AdRewardPanel #AdTimer {
    font-size: var(--fs-xl, 28px);
    -unity-font-definition: resource("Fonts/Outfit-SemiBold SDF");
    color: var(--color-accent-gold, rgb(217, 199, 115));
    -unity-text-align: middle-center;
    width: 100%;
    height: 36px;
    margin-top: var(--space-xs);
    letter-spacing: 2px;
}

/* === Gold Reward Badge === */
#AdRewardPanel #AdRewardBadge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(217, 199, 115, 0.08);
    border-width: 1px;
    border-color: rgba(217, 199, 115, 0.4);
    border-radius: 8px;
    padding: 12px 28px;
    margin-top: 10px;
}

#AdRewardPanel #AdRewardIcon {
    width: 52px;
    height: 52px;
    margin-right: 16px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(217, 199, 115);
}

#AdRewardPanel .reward-icon-coin {
    background-image: url("project://database/Assets/UI/Resources/Icons/icon_coin.svg");
}

#AdRewardPanel .reward-icon-exp {
    background-image: url("project://database/Assets/UI/Resources/Icons/icon_xp1.svg");
}

#AdRewardPanel .reward-icon-ammo {
    background-image: url("project://database/Assets/UI/Resources/Icons/icon_weapon_rifle.svg");
}

#AdRewardPanel .reward-icon-health {
    background-image: url("project://database/Assets/UI/Resources/Icons/icon_star.svg");
}

#AdRewardPanel #AdRewardText {
    font-size: 36px;
    -unity-font-definition: resource("Fonts/BlackOpsOne-Regular SDF");
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    color: rgb(217, 199, 115);
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    -unity-text-outline-width: 2px;
}

#AdRewardPanel #AdFooter {
    min-height: 0;
    height: auto;
    width: 100%;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0 32px;
    gap: 16px;
    margin-bottom: 24px;
    box-sizing: border-box;
}

/* === Ad Buttons (Sci-Fi Gold Tactical Theme) === */
#AdRewardPanel .ad-button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    max-width: 320px;
    height: 68px;
    margin: 0;
    align-self: center;
    background-color: rgba(16, 22, 30, 0.9);
    background-image: none;
    border-width: 1px;
    border-color: rgba(217, 199, 115, 0.4);
    border-radius: 4px;
    font-size: 22px;
    -unity-font-definition: resource("Fonts/Outfit-SemiBold SDF");
    color: rgb(217, 199, 115);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 3px;
    transition-property: scale, background-color, border-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

#AdRewardPanel .ad-button.ad-button-single {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 100%;
    max-width: 440px;
}

#AdRewardPanel .ad-button.btn-secondary {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(217, 199, 115, 0.2);
    color: rgba(217, 199, 115, 0.7);
}

#AdRewardPanel .ad-button.btn-secondary:hover {
    background-color: rgba(217, 199, 115, 0.1);
    border-color: rgba(217, 199, 115, 0.5);
    color: rgb(217, 199, 115);
}

#AdRewardPanel .ad-button:hover {
    scale: 1.05;
    background-color: rgba(217, 199, 115, 0.15);
    border-color: rgb(217, 199, 115);
    color: rgb(217, 199, 115);
}

#AdRewardPanel .ad-button:active {
    scale: 0.95;
    background-color: rgba(217, 199, 115, 0.05);
}

/* ===== AdMob Mockup Fullscreen Overlay Styles ===== */
#AdMobMockupOverlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(7, 11, 16, 0.96);
    flex-direction: column;
    justify-content: space-between;
    padding: 30px;
    z-index: 100;
}

#AdMobMockupHeader {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

#AdMobMockupBadge {
    background-color: rgba(217, 199, 115, 0.15);
    border-width: 1px;
    border-color: rgba(217, 199, 115, 0.4);
    border-radius: 4px;
    padding: 6px 14px;
}

#AdMobBadgeLabel {
    color: rgb(217, 199, 115);
    font-size: 14px;
    -unity-font-style: bold;
}

#AdMobHeaderRight {
    flex-direction: row;
    align-items: center;
}

.admob-skip-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(217, 199, 115, 0.3);
    border-radius: 4px;
    color: rgb(217, 199, 115);
    font-size: 14px;
    padding: 6px 16px;
    transition-duration: 0.15s;
}

.admob-skip-btn:hover {
    background-color: rgba(217, 199, 115, 0.2);
    border-color: rgb(217, 199, 115);
}

.admob-close-btn {
    background-color: rgba(217, 199, 115, 0.85);
    color: rgb(7, 11, 16);
    border-width: 0;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.admob-close-btn:hover {
    scale: 1.1;
    background-color: rgb(255, 220, 100);
}

#AdMobMockupBody {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

#AdMobBannerContainer {
    width: 80%;
    max-width: 600px;
    background-color: rgba(18, 25, 36, 0.9);
    border-width: 1.5px;
    border-color: rgba(217, 199, 115, 0.4);
    border-radius: 12px;
    padding: 30px;
    align-items: center;
}

#AdMobBannerTitle {
    color: rgb(217, 199, 115);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

#AdMobBannerSub {
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    margin-bottom: 24px;
}

#AdMobMediaBox {
    width: 100%;
    height: 140px;
    background-color: rgba(7, 11, 16, 0.8);
    border-width: 1px;
    border-color: rgba(217, 199, 115, 0.2);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
}

#AdMobMediaIcon {
    width: 48px;
    height: 48px;
    margin-bottom: 10px;
    background-image: resource("Icons/AdIcon");
    -unity-background-image-tint: rgb(217, 199, 115);
}

#AdMobMockupTimerLabel {
    color: rgb(217, 199, 115);
    font-size: 18px;
    -unity-font-style: bold;
}

#AdMobProgressBarTrack {
    width: 80%;
    max-width: 600px;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    margin-top: 20px;
    overflow: hidden;
}

#AdMobProgressBarFill {
    width: 0%;
    height: 100%;
    background-color: rgb(217, 199, 115);
    border-radius: 4px;
}

#AdMobMockupFooter {
    align-items: center;
}

#AdMobFooterHint {
    color: rgba(255, 255, 255, 0.4);
    font-size: 13px;
}

/* ===== Skip Confirm Modal Styles ===== */
#AdMobSkipConfirmModal {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    z-index: 200;
}

#AdMobConfirmCard {
    width: 420px;
    background-color: rgb(18, 25, 36);
    border-width: 1.5px;
    border-color: rgb(217, 199, 115);
    border-radius: 10px;
    padding: 24px;
    align-items: center;
}

#AdMobConfirmTitle {
    color: rgb(217, 199, 115);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

#AdMobConfirmMsg {
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

#AdMobConfirmFooter {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.admob-btn-primary {
    flex-grow: 1;
    margin-right: 8px;
    height: 42px;
    background-color: rgb(217, 199, 115);
    color: rgb(7, 11, 16);
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 4px;
    transition-duration: 0.15s;
}

.admob-btn-primary:hover {
    scale: 1.03;
    background-color: rgb(255, 220, 100);
}

.admob-btn-danger {
    flex-grow: 1;
    margin-left: 8px;
    height: 42px;
    background-color: rgba(220, 50, 50, 0.2);
    border-width: 1px;
    border-color: rgb(220, 50, 50);
    color: rgb(255, 100, 100);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 4px;
    transition-duration: 0.15s;
}

.admob-btn-danger:hover {
    scale: 1.03;
    background-color: rgba(220, 50, 50, 0.4);
}
